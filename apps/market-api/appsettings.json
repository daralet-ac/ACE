{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "c:\\ACE\\Logs\\market-api-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "Database": {
    "Host": "127.0.0.1",
    "Port": 3307,
    "ShardDatabase": "ace_shard",
    "WorldDatabase": "ace_world",
    "AuthDatabase": "ace_auth",
    "Username": "",
    "Password": ""
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
